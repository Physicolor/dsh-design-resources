        { "match": "panelRow", "where": "spec/10-frame-layout.md", "note": "左栏面板导航行（插件 / 自动化任务）" },
        { "match": "triggerRow", "where": "components/layout/SettingsRow", "note": "左栏底部设置行" },
        { "match": "panelTitle", "where": "components/layout/PanelHeader", "note": "面板标题（含分组标题行）" },
        { "match": "settingsCard", "where": "components/surfaces/Card", "note": "设置页卡片" },
