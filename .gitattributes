# One line ending everywhere.
#
# The generated site data embeds whole files (specimens, stylesheets, component
# source) verbatim, so a checkout that rewrites LF to CRLF produces a different
# `website/js/data.js` from the same commit — `gen-site.mjs --check` then passes
# on Windows and fails in CI. Declaring LF for text makes the generated file
# depend on the repository, not on the machine that cloned it.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
